  "product_defect": {
    "file": "src/protocol.rs",
    "site": "validate_envelope operation-attribute allowlist",
    "before": "9 | 11 => key == \"requested-attributes\"",
    "after": "11 => matches!(key, \"requested-attributes\" | \"document-format\"); 10 also accepts document-format",
    "rejected_status": "client-error-document-format-not-supported (0x040a) with zero Printer Attributes",
    "spec": "RFC 8011 \u00a74.2.5.1 Get-Printer-Attributes Request: Client MAY supply document-format, Printer MUST support it; a Printer that does not distinguish per-format sets MUST NOT distinguish in this operation"
  },
  "test_script_limitation": {
