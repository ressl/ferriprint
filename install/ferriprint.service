[Unit]
Description=Ferriprint isolated IPPS frontend
# Ordering only: optional discovery does not activate or restart global daemons.
After=network-online.target cups.service avahi-daemon.service dbus.service
Wants=network-online.target

[Service]
Type=simple
User=ferriprint
Group=ferriprint
ExecStart=/usr/bin/ferriprint --config /etc/ferriprint/ferriprint.toml serve
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
UMask=0077
StateDirectory=ferriprint
StateDirectoryMode=0700
WorkingDirectory=/var/lib/ferriprint
LoadCredential=server.crt:/etc/ferriprint/tls/fullchain.pem
LoadCredential=server.key:/etc/ferriprint/tls/privkey.pem
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
