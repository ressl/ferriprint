 #define WAL_RETRY  (-1)
 
+/* QA-only derivative instrumentation; not an upstream SQLite API. */
+#define FERRIPRINT_QA_WAL_REASON_COUNT 15
+#define FERRIPRINT_QA_DMS_METADATA_COUNT 3
+static u32 ferriprintQaWalCounts[FERRIPRINT_QA_WAL_REASON_COUNT];
+static int ferriprintQaDmsFirstValues[FERRIPRINT_QA_DMS_METADATA_COUNT];
+static void ferriprintQaWalCount(unsigned int reason){
+  assert( reason<FERRIPRINT_QA_WAL_REASON_COUNT );
+  if( ferriprintQaWalCounts[reason]!=0xffffffffu ){
+    ferriprintQaWalCounts[reason]++;
+  }
+}
+static void ferriprintQaDmsFirst(unsigned int reason, unsigned int slot, int value){
+  assert( reason>=12 && reason<FERRIPRINT_QA_WAL_REASON_COUNT );
+  assert( slot<FERRIPRINT_QA_DMS_METADATA_COUNT );
+  if( ferriprintQaWalCounts[reason]==0 ) ferriprintQaDmsFirstValues[slot] = value;
+  ferriprintQaWalCount(reason);
+}
+#define FERRIPRINT_QA_WAL_RETRY(ID) (ferriprintQaWalCount(ID), WAL_RETRY)
+SQLITE_API int ferriprint_qa_sqlite_wal_retry_counts_v2(
+  unsigned int*, int, int*, int
+);
+SQLITE_API int ferriprint_qa_sqlite_wal_retry_counts_v2(
+  unsigned int *out, int count, int *metadata, int metadataCount
+){
+  unsigned int i;
+  if( out==0 || count!=FERRIPRINT_QA_WAL_REASON_COUNT
+   || metadata==0 || metadataCount!=FERRIPRINT_QA_DMS_METADATA_COUNT ) return 0;
+  for(i=0; i<FERRIPRINT_QA_WAL_REASON_COUNT; i++) out[i] = ferriprintQaWalCounts[i];
+  for(i=0; i<FERRIPRINT_QA_DMS_METADATA_COUNT; i++) metadata[i] = ferriprintQaDmsFirstValues[i];
+  return FERRIPRINT_QA_WAL_REASON_COUNT;
+}
